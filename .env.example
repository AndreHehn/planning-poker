# Planning Poker — Configuration
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env

# Port the server listens on
PORT=3000

# How many hours a room lives before it is automatically deleted
ROOM_TTL_HOURS=24

# Maximum number of rooms held in memory at the same time (0 = unlimited)
MAX_ROOMS=0

# Maximum number of users allowed per room (0 = unlimited)
MAX_USERS_PER_ROOM=0
